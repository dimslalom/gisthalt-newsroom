# Use file mode for CLI-only development; Docker overrides this with its database.
DATABASE_URL=
STORE_BACKEND=file
STORE_FILE=./.data/store.json
TZ=Australia/Brisbane
RENDERER_URL=http://127.0.0.1:8787
RENDER_OUT_DIR=./.data/renders
ARCHIVE_DIR=./.data/archive
AGENT_PROFILE_ROOT=./.data/profiles
PUBLISH_RECEIPT_DIR=./.data/receipts
PUBLISH_DRY_RUN=true
PUBLISH_KILL_SWITCH=false
PUBLISH_JITTER_MAX_MINUTES=9
PUBLISH_MIN_INTERVAL_SECONDS=300
# Native Windows agent: validates every active Chrome profile every five
# minutes and always repeats that check immediately before a live submission.
AGENT_SESSION_CHECK_MS=300000
AGENT_POLL_MS=5000
ENABLE_R2=false
ENABLE_R3=false
LIVE_WINDOW=0
GEMINI_API_KEY=
# Optional JSON array: model, rpm, rpd, role (extract|classify / copy / adjudicate), fallback.
MODEL_LIMITS_JSON=
TMDB_API_KEY=
# Orange Cat Blacktop (ocblacktop.com/api), Hobby plan or above — required for
# live in-session F1 timing (blacktop.ts). Without it, that source no-ops.
BLACKTOP_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_IDS=
DISCORD_REVIEW_F1_CHANNEL_ID=
DISCORD_REVIEW_VCT_CHANNEL_ID=
DISCORD_REVIEW_FILM_CHANNEL_ID=
DISCORD_PUBLISHED_CHANNEL_ID=
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_FIREHOSE_CHANNEL_ID=
